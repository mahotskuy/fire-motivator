rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace YOUR_UID with the UID shown in the app after the first sign-in
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == "YOUR_UID" && uid == "YOUR_UID";
    }
  }
}
